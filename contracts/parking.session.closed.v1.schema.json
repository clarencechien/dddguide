{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clarencechien/dddguide/contracts/parking.session.closed.v1.schema.json",
  "title": "parking.session.closed.v1",
  "description": "Published by Parking when the vehicle left (T6). Subscribers: Billing. Dedup key: parkingSessionId.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "parking.session.closed.v1" },
        "version": { "const": 1 },
        "producer": { "const": "parking" },
        "payload": {
          "type": "object",
          "required": ["parkingSessionId", "plate", "durationMin", "releaseMode"],
          "properties": {
            "parkingSessionId": { "type": "string", "pattern": "^P-" },
            "plate": { "type": "string", "minLength": 1 },
            "durationMin": { "type": "integer", "minimum": 0 },
            "releaseMode": { "type": "string", "enum": ["Auto", "Manual"], "description": "Manual = shift lead released by hand while HQ was unreachable (R6)" }
          }
        }
      }
    }
  ]
}
