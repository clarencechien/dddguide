{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clarencechien/dddguide/contracts/charging.session.started.v1.schema.json",
  "title": "charging.session.started.v1",
  "description": "Published by Charging when a start was authorised (T3). Subscribers: Billing draft, Parking. Dedup key: sessionId.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "charging.session.started.v1" },
        "version": { "const": 1 },
        "producer": { "const": "charging" },
        "payload": {
          "type": "object",
          "required": ["sessionId", "connectorId", "idTag", "startedAt"],
          "properties": {
            "sessionId": { "type": "string", "pattern": "^S-" },
            "connectorId": { "type": "string", "pattern": "^.+-[0-9]+$" },
            "idTag": { "type": "string", "minLength": 1, "maxLength": 20 },
            "startedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
